// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
} 

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Role {
  id String @id @default(cuid())
  name String @unique

  description String?

   users User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission{
  id String @id @default(cuid())
  resource String 
  action String 
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([resource, action])
}

model RolePermission {
  id String @id @default(cuid())

  roleId String
  role Role @relation(fields: [roleId], references: [id])

  permissionId String
  permission Permission @relation(fields: [permissionId], references: [id])

  scope Scope?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, permissionId])
}

enum Scope{
SELF
TEAM
DEPARTMENT
SUBORDINATES
COMPANY
}

model User {
  id       String @id @default(cuid()) 
  email    String @unique
  password String
 

  employee Employee?

  isActive Boolean @default(true)

  roleId String  
  role Role @relation(fields:[roleId],references:[id])

  profileImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmployeeStatus {
  PROBATION
  NOTICE_PERIOD
  ACTIVE
  RESIGNED
  TERMINATED
}

enum EmployeeType{
  FULL_TIME
  INTERN
  CONTRACT
}

model Employee {
  id String @id @default(cuid())

  firstName String
  lastName String

  phone String

  dateOfBirth DateTime

  gender Gender @default(MALE)

  joiningDate DateTime

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  designationId String
  designation   Designation @relation(fields: [designationId], references: [id])

  
  reportsToId  String?
  manager      Employee?  @relation("ManagerToEmployee", fields: [reportsToId], references: [id])
  subordinates Employee[] @relation("ManagerToEmployee")

  leaveBalances EmployeeLeaveBalance[]
  leaveRequests LeaveRequest[]
  leaveApprovals LeaveApprovalHistory[]

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])



  salary Int @default(0)

  probationStart DateTime?
  probationEnd DateTime?

  noticePeriodDays Int @default(0)

  employmentStatus EmployeeStatus @default(PROBATION)
  employeeType EmployeeType @default(INTERN)


   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Holiday {
  id   String   @id @default(cuid())
  name String
  date DateTime @unique

  createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model Department {
  id   String @id @default(cuid())
  name String @unique

  employees    Employee[]
  designations Designation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Designation {
  id   String @id @default(cuid())
  name String

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  employees Employee[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model CompneySettings{
  id   String @id @default(cuid())
  
  companyName String
  timezone    String
  currency    String

  officeStartTime DateTime?
  officeEndTime   DateTime?
  workingMinutes    Int

  defaultProbationMonths Int
  defaultNoticePeriodDays Int

  lateGraceMinutes Int

  weeklyOffDays String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}



model LeaveType{
  id String @id @default(cuid())
  name String 
  description String 
  isActive Boolean @default(false)

  leavePolicies LeavePolicy[]

  balances EmployeeLeaveBalance[]
  leaveRequests LeaveRequest[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeavePolicy{
 id String @id @default(cuid())

 leaveTypeId String
 leaveType LeaveType @relation(fields:[leaveTypeId],references:[id], onDelete: Cascade)  

 employeeType EmployeeType @default(FULL_TIME)
 
 annualAllocation Float

  carryForward     Boolean @default(false)
  maxCarryForward  Float?

  monthlyAccrual   Boolean @default(false)

  halfDayAllowed     Boolean @default(true)
  probationEligible  Boolean @default(true)

  isPaid             Boolean @default(true)
  requiresApproval   Boolean @default(true)

 isActive Boolean @default(true)
   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveSettings {
  id String @id @default(cuid())

  // Leave Calendar
  leaveYearStartMonth Int // 1 = January, 4 = April

  // Sandwich Leave
  sandwichLeaveEnabled    Boolean @default(false)
  countWeekendInSandwich  Boolean @default(false)
  countHolidayInSandwich  Boolean @default(false)

  // Backdated Leave
  allowBackdatedLeave Boolean @default(false)
  backdatedLimitDays  Int?

  // Future Leave
  allowFutureLeave Boolean @default(true)
  futureLimitDays  Int?

  // General Restrictions
  defaultMinNoticeDays        Int?
  defaultMaxConsecutiveDays   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeLeaveBalance {
  id String @id @default(cuid())

  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveTypeId String
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  year Int

  // From LeavePolicy
  allocated Float @default(0)

  // Previous year remaining leaves
  carriedForward Float @default(0)

  // Leaves already approved and used
  used Float @default(0)

  // Leave requests waiting for approval
  pending Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}


enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveApprovalAction {
  APPROVED
  REJECTED
}

model LeaveRequest {
  id String @id @default(cuid())

  // Employee
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Leave Type
  leaveTypeId String
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  // Leave Duration
  startDate DateTime
  endDate DateTime
  totalDays Float

  // Half-day support
  isHalfDay Boolean @default(false)

  // Employee reason
  reason String?

  // Approval Status
  status LeaveStatus @default(PENDING)

  // Cancellation
  cancelledReason String?

  // Approval History
  approvalHistories LeaveApprovalHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model LeaveApprovalHistory {
  id String @id @default(cuid())

  leaveRequestId String
  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  actionById String
  actionBy Employee @relation(fields: [actionById], references: [id])

  action LeaveApprovalAction
  comment String?

  createdAt DateTime @default(now())
}