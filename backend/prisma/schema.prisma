generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Roles{
  SUPER ADMIN,
  ADMIN,
  EMPLOYEE  
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String 

  role Roles @default(EMPLOYEE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  
  }
